NEXT_PUBLIC_SOCIAL_GITHUB="https://github.com/tuoprofilo"
NEXT_PUBLIC_SOCIAL_LINKEDIN="https://linkedin.com/in/tuoprofilo"
NEXT_PUBLIC_SOCIAL_INSTAGRAM="https://instagram.com/tuoprofilo"
# Password dell'area /reports (facoltativa, default "antigravity")
NEXT_PUBLIC_REPORTS_PASSWORD="antigravity"
# Base URL del backend prenotazioni (facoltativa; vuota = stessa origine del sito).
# Utile per far parlare una copia del sito (es. localhost o Firebase) col Worker:
# NEXT_PUBLIC_BOOKINGS_API="https://agenzia-web-claudecode.gabrielefornabaio.workers.dev"
NEXT_PUBLIC_BOOKINGS_API=""
# Chiave accettata dal pannello /prenotazioni/gestione in modalità demo (default "antigravity").
# In modalità remota fa fede BOOKINGS_ADMIN_KEY impostata sul Worker (wrangler.toml / dashboard).
NEXT_PUBLIC_BOOKINGS_ADMIN_KEY="antigravity"
